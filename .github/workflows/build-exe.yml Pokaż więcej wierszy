name: Build EXE

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: windows-latest

    steps:
    - uses: actions/checkout@v4

    - uses: actions/setup-python@v5
      with:
        python-version: '3.11'

    - name: Install dependencies
      run: |
        pip install pandas
        pip install openpyxl
        pip install numpy
        pip install xlsxwriter
        pip install pyinstaller

    - name: Build EXE
      run: |
        pyinstaller --onefile --windowed Aplikacja_WK35_Raport_Fruehwarnsystem_ver1.py

    - name: Upload EXE
      uses: actions/upload-artifact@v4
      with:
        name: Fruehwarnsystem_EXE
        path: dist/*.exe
